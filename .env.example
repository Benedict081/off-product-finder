# ---------------------------------------------------------------------------
# Backend  ->  copy this file to apps/api/.env and fill in the real values
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MySQL. A Homebrew install gives root an empty password by default.
DATABASE_URL="mysql://root:@localhost:3306/off_finder"

# Origin of the Next.js app: used for CORS and for Stripe's return URLs.
WEB_APP_URL="http://localhost:3000"

# Open Food Facts asks API consumers to identify themselves, and throttles
# traffic that does not. Put a real contact address here.
OFF_USER_AGENT="OFFProductFinder/1.0 (technical-test; you@example.com)"
OFF_SEARCH_BASE_URL="https://search.openfoodfacts.org"
OFF_PRODUCT_BASE_URL="https://world.openfoodfacts.org"
OFF_TIMEOUT_MS=8000

# Stripe TEST mode only — dashboard.stripe.com with the test toggle on.
STRIPE_SECRET_KEY="sk_test_replace_me"
# Printed by: stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Monthly recurring price. Create one with: npm run stripe:price -w apps/api
STRIPE_PRICE_ID="price_replace_me"

# The single demo user created by `npm run db:seed`.
DEMO_USER_EMAIL="demo@example.com"

# ---------------------------------------------------------------------------
# Frontend  ->  copy the line below into apps/web/.env.local
# ---------------------------------------------------------------------------

# Server-side only: the Next.js server calls Express at this address. It is not
# a NEXT_PUBLIC_ variable, so it never reaches the browser bundle.
API_BASE_URL="http://localhost:4000"
